# ==============================
# Supabase (Database + Storage + Auth)
# ==============================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # hanya dipakai di server, JANGAN expose ke client

# ==============================
# Storage
# ==============================
SUPABASE_STORAGE_BUCKET=product-photos

# ==============================
# AI Image Generation Provider
# ==============================
# Isi sesuai provider yang dipakai (contoh: OpenAI, Stability AI, Nano Banana, dll)
AI_IMAGE_PROVIDER_API_KEY=your-api-key
AI_IMAGE_PROVIDER_BASE_URL=https://api.example.com

# ==============================
# Scraper Service
# ==============================
# Kalau pakai third-party scraping service (misal ScraperAPI, Bright Data, dll)
SCRAPER_API_KEY=your-scraper-api-key
SCRAPER_BASE_URL=https://api.scraperservice.com

# ==============================
# Job Queue
# ==============================
# Isi sesuai pilihan queue (contoh: Redis untuk BullMQ)
REDIS_URL=redis://localhost:6379

# ==============================
# App Config
# ==============================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
